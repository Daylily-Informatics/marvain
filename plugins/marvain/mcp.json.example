{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "marvain": {
      "type": "streamable-http",
      "url": "https://marvain.example.invalid/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "REPLACE_WITH_REGISTERED_OAUTH_CLIENT_ID",
              "tokenEndpointAuthMethod": "none"
            }
          }
        }
      }
    }
  }
}
